---
import Page from '../../layouts/Page.astro';
import EnquiryForm from '../EnquiryForm.astro';
import Footer from '../Footer.astro';
import Artifact from './Artifact.astro';
import Ladder from './Ladder.astro';
import Scope from './Scope.astro';
import Faq from './Faq.astro';
import Related from './Related.astro';
import { serviceRoutes, sourceContexts } from '../../services/routes.js';
import { copy } from '../../content/copy.js';
import '../../styles/services.css';
const {page,locale}=Astro.props;const en=locale==='en';const c=page[locale];const route=serviceRoutes[page.key];
const origin='https://local.runlumi.app';const url=origin+route[locale];const label=route.type==='industry'?(en?'Industries':'Ngành'):(en?'Services':'Dịch vụ');
const home=en?'/en/':'/';const context=sourceContexts.find(x=>x.source===route[locale]);
const cta=route.intent==='check'?(en?'Check my business':'Kiểm tra business của tôi'):route.intent==='trust-kit'?(en?'Show me the Trust Kit for my business':'Xem Trust Kit cho business của tôi'):copy[locale].cta;
const schema={'@context':'https://schema.org','@graph':[
 {'@type':'Organization','@id':origin+'/#organization',name:'Lumi Local',url:origin+'/',parentOrganization:{'@type':'Organization',name:'RunLumi',url:'https://runlumi.app/'}},
 {'@type':'WebSite','@id':origin+'/#website',name:'Lumi Local',url:origin+'/'},
 {'@type':route.type==='industry'?'WebPage':'Service',name:c.label,description:c.description,url,inLanguage:en?'en-VN':'vi-VN',...(route.type==='service'?{provider:{'@id':origin+'/#organization'},areaServed:{'@type':'Country',name:'Vietnam'}}:{})},
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Lumi Local',item:origin+home},{'@type':'ListItem',position:2,name:label,item:origin+home+'#dich-vu'},{'@type':'ListItem',position:3,name:c.label,item:url}]}
]};
---
<Page locale={locale} title={c.title} description={c.description} routePair={route} schema={schema}>
<header class="site-header glass-control"><div class="wrap header-inner"><a class="brand" href={home}><img src="/brand/lumi-logo.svg" width="34" height="34" alt=""/><span><strong>Lumi</strong> Local</span></a><nav class="desktop-nav" aria-label={en?'Navigation':'Điều hướng'}><a href={home+'#dich-vu'}>{label}</a><a href="#goi-dich-vu">{en?'Packages':'Gói dịch vụ'}</a><a href="#cau-hoi">{en?'FAQ':'Câu hỏi'}</a></nav><div class="header-actions"><a class="service-lang" href={route[en?'vi':'en']} lang={en?'vi':'en'} aria-label={en?'Đọc bằng tiếng Việt':'Read in English'}>{en?'VI':'EN'}</a><a class="button button-primary header-cta" href="#bat-dau">{en?'Get a preview':'Xem thử'}</a></div></div></header>
<main id="main" class="wrap service-main"><nav class="service-breadcrumb" aria-label={en?'Breadcrumb':'Đường dẫn'}><a href={home}>Lumi Local</a><span aria-hidden="true">/</span><a href={home+'#dich-vu'}>{label}</a><span aria-hidden="true">/</span><span>{c.label}</span></nav>
<section class="service-hero"><div><p class="eyebrow">{c.label}</p><h1>{c.h1}</h1><p class="service-lede">{c.lead}</p><p class="service-hero-price">{page.key==='qr'?(en?'Trust Kit · 399,000 VND':'Trust Kit · 399.000đ'):page.key==='check'||page.key==='maps'?(en?'Confirm the need before choosing a package.':'Xác nhận nhu cầu trước khi chọn gói.'):(en?'Starter · 1,990,000 VND':'Starter · 1.990.000đ')} {['check','maps'].includes(page.key)?'':en?(page.key==='qr'?'one-time':'year one'):(page.key==='qr'?'một lần':'năm đầu')}</p><a class="button button-primary" href="#bat-dau">{cta}</a><p class="meta">{en?'An enquiry, not payment, an account or a reserved slot.':'Gửi nhu cầu; chưa thanh toán, tạo tài khoản hay giữ chỗ.'}</p></div><Artifact page={page} locale={locale}/></section>
<div class="service-content">{c.sections.map((s,i)=><section id={`noi-dung-${i+1}`}><p class="index">0{i+1}</p><h2>{s.title}</h2><p>{s.body}</p>{s.items&&<ul>{s.items.map(item=><li>{item}</li>)}</ul>}{page.key==='qr' && i===2 && <p><a class="text-link" href={`https://support.google.com/business/answer/16816815?hl=${locale}`}>{en?'Create your own review link or QR with Google':'Tự lấy đường dẫn hoặc mã QR theo hướng dẫn Google'} ↗</a></p>}</section>)}</div>
{page.key==='qr' && <section class="review-invitation"><h2>{en?'The invitation on your artwork.':'Lời mời trên artwork của bạn.'}</h2><blockquote>{en?'Have you used our service? Scan the QR to share your experience on Google. All feedback is welcome.':'Bạn đã sử dụng dịch vụ của chúng tôi? Quét QR để chia sẻ trải nghiệm trên Google. Mọi phản hồi đều được trân trọng.'}</blockquote><p>{en?'Safe: the same voluntary invitation to every genuine customer. Unsafe: rewards, requested ratings, purchased reviews or screening for happy customers.':'Phù hợp: cùng một lời mời tự nguyện tới tất cả khách thật. Không phù hợp: quà thưởng, yêu cầu số sao, mua đánh giá hay chọn lọc khách hài lòng.'}</p><a class="text-link" href="https://support.google.com/business/answer/3474122">{en?'Google’s official review guidance':'Hướng dẫn đánh giá của Google'} ↗</a></section>}
<Scope locale={locale}/><Ladder locale={locale}/>
<section class="service-process"><p class="eyebrow">{en?'Done for you, approved by you':'Lumi làm, chủ xác nhận'}</p><h2>{en?'Three steps to the agreed deliverable.':'Ba bước tới phần bàn giao.'}</h2><ol><li><strong>{en?'Share the need':'Gửi nhu cầu'}</strong><p>{en?'Business name, contact and what is missing. No Google credentials.':'Tên cơ sở, liên hệ và phần còn thiếu. Không gửi thông tin đăng nhập Google.'}</p></li><li><strong>{en?'Review the scope and preview':'Duyệt phạm vi và bản xem thử'}</strong><p>{en?'Lumi checks public context; the owner confirms facts, assets, prices and scope.':'Lumi xem bối cảnh công khai; chủ xác nhận sự thật, tài sản, giá và phạm vi.'}</p></li><li><strong>{en?'Approve and receive':'Xác nhận và nhận bàn giao'}</strong><p>{en?'Agreed revision, owner approval, then files/publication. Delivery timing is confirmed for the actual job.':'Sửa theo phạm vi, chủ duyệt rồi nhận file/xuất bản. Thời gian được chốt theo công việc thật.'}</p></li></ol></section>
<Faq locale={locale} items={c.faq}/><Related locale={locale} keys={page.related}/>
<section class="service-enquiry contact" id="bat-dau"><div><p class="eyebrow">{c.label}</p><h2>{en?'Show us what your business needs.':'Cho Lumi biết business đang cần gì.'}</h2><p>{copy[locale].form.text}</p><p class="meta">{copy[locale].form.privacy}</p><p class="meta">{en?'This form is for Lumi services, not an appointment with an illustrated business.':'Form dành cho dịch vụ Lumi, không phải đặt lịch với cơ sở trong ví dụ minh họa.'}</p></div><EnquiryForm locale={locale} context={context}/></section>
</main><Footer locale={locale}/><script is:inline src="/enquiry.js"></script>
</Page>
