---
import ScenePhoto from '../ScenePhoto.astro';
const {page,locale}=Astro.props;
const en=locale==='en';const c=page[locale];
---
<figure class="service-artifact sheet"><figcaption><span class="eyebrow">{page.key==='qr'?(en?'AI-generated mockup · not a customer installation':'Ảnh minh họa bằng AI · không phải quầy khách hàng'):(en?'Illustrative layout · not a customer site':'Bố cục minh họa · không phải website khách hàng')}</span><h2>{c.artifactTitle}</h2></figcaption>
{page.key==='qr'?<div class="qr-layout">
  <ScenePhoto name={`qr-counter-${locale}`} class="qr-counter-photo" sizes="(max-width: 680px) calc(100vw - 82px), (max-width: 900px) 40vw, 440px" eager />
  <div class="qr-copy">
    <p>{en?'Have you used our service? Scan the QR to share your experience on Google. All feedback is welcome.':'Bạn đã sử dụng dịch vụ của chúng tôi? Quét QR để chia sẻ trải nghiệm trên Google. Mọi phản hồi đều được trân trọng.'}</p>
    <small>{en?'Illustrative QR, not for scanning. Printing and physical stands are excluded.':'Mã minh họa, không dùng để quét. Không bao gồm in ấn và giá đỡ.'}</small>
  </div>
</div>:<div class="service-preview"><p class="preview-address">{en?'Your business · owner-approved information':'Business của bạn · nội dung do chủ duyệt'}</p><ol>{c.artifactRows.map((row,i)=><li><span class="index">0{i+1}</span><span>{row}</span></li>)}</ol><nav class="glass-control artifact-dock" aria-label={en?'Preview contact actions':'Tác vụ liên hệ trong bản xem thử'}><a href="#bat-dau">{en?'Call setup':'Nút gọi'}</a><a href="#bat-dau">Zalo</a><a href="#bat-dau">{en?'Directions setup':'Chỉ đường'}</a></nav><p class="meta">{en?'Illustrative actions open the Lumi enquiry; no real shop, appointment or emergency contact is implied.':'Tác vụ minh họa mở form Lumi; không phải liên hệ cửa hàng, lịch hẹn hay cứu hộ thực tế.'}</p></div>}
{page.key==='qr' && <ul>{c.artifactRows.map(row=><li>{row}</li>)}</ul>}
</figure>
