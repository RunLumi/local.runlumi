---
// Reef's full-width featured band and quiet archive cards, adapted to Lumi.
import Photograph from './Photograph.astro';
import { articleUrl, topicFor, base, readingMinutes } from '../../blog/site.js';
const { post, featured = false } = Astro.props;
const topic = topicFor(post.topic);
const locale = post.locale;
---
<article class:list={['post-card', featured && 'post-featured']}>
  <div class="post-card-copy">
    <a class="eyebrow" href={`${base(locale)}topics/${post.topic}/`}>{topic?.[locale]}</a>
    <h2><a href={articleUrl(post)}>{post.title}</a></h2>
    <p>{post.description}</p>
    <div class="post-bottom"><span class="meta">Lumi Local · {readingMinutes(post)} {locale === 'vi' ? 'phút đọc' : 'min read'}</span><a class="text-link" href={articleUrl(post)}>{locale === 'vi' ? 'Đọc bài' : 'Read guide'} <span aria-hidden="true">↗</span></a></div>
  </div>
  <Photograph post={post} variant="card" eager={featured}/>
</article>
