---
// Reef's full-width featured band and quiet archive cards, adapted to Lumi.
import { articleUrl, topicFor, base, readingMinutes } from '../../blog/site.js';
const { post, featured = false } = Astro.props;
const topic = topicFor(post.topic);
const locale = post.locale;
---
<article class:list={['post-card', featured && 'post-featured']}>
  <div class="post-card-copy">
    <a class="eyebrow" href={`${base(locale)}topics/${post.topic}/`}>{topic?.[locale]}</a>
    <h2><a href={articleUrl(post)}>{post.title}</a></h2>
    <p>{post.description}</p>
    <div class="post-bottom"><span class="meta">Lumi Local · {readingMinutes(post)} {locale === 'vi' ? 'phút đọc' : 'min read'}</span><a class="text-link" href={articleUrl(post)}>{locale === 'vi' ? 'Đọc bài' : 'Read guide'} <span aria-hidden="true">↗</span></a></div>
  </div>
  {featured && <div class="editorial-art" aria-hidden="true">
    <svg viewBox="0 0 440 360" fill="none"><path d="M0 90H440M0 180H440M0 270H440M110 0V360M220 0V360M330 0V360" stroke="#c8d0de"/><path d="M65 265H157V165H283V88H390" stroke="#006093" stroke-width="5"/><circle cx="65" cy="265" r="10" fill="#006093"/><path d="M283 69c-28 0-49 21-49 47 0 34 49 79 49 79s49-45 49-79c0-26-21-47-49-47Z" fill="#fff" stroke="#102a43" stroke-width="3"/><circle cx="283" cy="116" r="15" stroke="#006093" stroke-width="3"/><rect x="37" y="43" width="129" height="86" rx="8" fill="#fff" stroke="#c8d0de"/><path d="M53 63h74M53 79h94M53 95h47" stroke="#006093" stroke-width="3"/><path d="M335 234h49v49h-49zM345 244h29v29h-29z" stroke="#102a43" stroke-width="4"/><path d="m340 321 51-12" stroke="#006093" stroke-width="3"/></svg>
    <p>{locale === 'vi' ? 'Chỉ đường · Thông tin · Liên hệ' : 'Directions · Information · Contact'}</p>
  </div>}
</article>
