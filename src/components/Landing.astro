      renewal:{name:'From year two',price:'599k / 999k',unit:'per year',text:'599k with a RunLumi address. 999k with one standard custom domain, hosting, SSL and maintenance.',bullets:['599k: RunLumi Address','999k: standard custom domain','Premium domains quoted separately']},
      credit:'Bought Trust Kit? Upgrade within 30 days and pay only 1,591,000 VND more.'
    },
    convenience:{eyebrow:'We do not sell code',title:'You pay so you do not have to do it yourself.',text:'AI makes websites faster. Lumi Local adds the context, setup, publishing, technical ownership and a clear place for customers to understand and contact your business.',items:[['01','Lumi prepares','We use verified business context instead of asking you to start from a blank page.'],['02','You review','You check content and imagery and give bounded feedback.'],['03','Lumi publishes','Domain/subdomain, hosting, SSL, contact actions, QR and form are set up within scope.']]},
    included:{eyebrow:'Lumi Local Starter',title:'A practical online presence that is ready to use.',intro:'The essential pieces are bundled so the owner does not have to coordinate multiple vendors.',items:[['Mobile-first website','Clear services and contact information on phones.'],['Call / Zalo','Direct contact actions from the page.'],['Google Maps','Show location without giving Lumi profile control.'],['Review QR','Help real customers reach the appropriate Google review flow.'],['Hosting + SSL','Lumi handles the infrastructure within scope.'],['Local Presence Alerts','Public-data alerts where the corresponding feature is implemented.']]},
