---
import Page from '../layouts/Page.astro';
import EnquiryForm from './EnquiryForm.astro';
import ServiceDirectory from './services/Directory.astro';
import { copy } from '../content/copy.js';
import ScenePhoto from './ScenePhoto.astro';
import ServiceIcon from './ServiceIcon.astro';

interface Props { locale: 'vi' | 'en' }
const { locale } = Astro.props;


const c = copy[locale];
const illustrationNote = locale === 'vi' ? 'Giao diện và hình ảnh minh họa bằng AI; không phải khách hàng hay kết quả thực tế.' : 'Concept interfaces and AI-generated imagery; not real customers or business results.';

/* Hero Operating Desk Stage 2.0 — illustrative industry concepts.
   All three render server-side; the switcher crossfades between them
   and no-JS visitors simply see the first concept. */
const industries = {
  vi: [
    {
      key:'cafe', tab:'Cà phê / F&B', short:'Cà phê', icon:'cup',
      accent:'', accentPhoto:'',
      biz:'AN NHIÊN', initials:'AN', domain:'annhien.runlumi.app',
      navLinks:['Menu & Giá','Về quán','Liên hệ'],
      kicker:'Tiệm cà phê địa phương', live:'Đang mở cửa',
      headline:'Một góc nhỏ thân quen, giới\u00A0thiệu thật chỉn chu.',
      sub:'Thực đơn món, địa chỉ, giờ đón khách và nút liên hệ đặt ngay nơi khách cần tìm.',
      phone:'0908 123 456',
      phoneTitle:'Cà phê ngon. Dễ tìm. Dễ gọi.',
      features:[['cup','Cà phê pha mộc','Pha phin & Pha máy'],['pastry','Bánh nướng trong ngày','Làm mới mỗi sáng'],['chair','Không gian yên tĩnh','Wifi mạnh & Bàn làm việc']]
    },
    {
      key:'spa', tab:'Spa & Thẩm mỹ', short:'Spa', icon:'lotus',
      accent:'accent-fresh', accentPhoto:'accent-fresh',
      biz:'MỘC BEAUTY', initials:'MB', domain:'mocbeauty.runlumi.app',
      navLinks:['Dịch vụ & Giá','Không gian','Đặt lịch'],
      kicker:'Spa & chăm sóc da', live:'Còn lịch hôm nay',
      headline:'Thư giãn đúng chất spa. Đặt lịch chỉ một chạm.',
      sub:'Bảng dịch vụ, mức giá tham khảo và nút đặt lịch qua Zalo đặt ngay nơi khách đang lướt.',
      phone:'0917 246 810',
      phoneTitle:'Nghỉ ngơi xứng đáng. Đặt lịch nhẹ nhàng.',
      features:[['lotus','Massage & Chăm sóc da','Liệu trình 60–90 phút'],['leaf','Mỹ phẩm thiên nhiên','Thương hiệu chọn lọc'],['calendar','Đặt lịch qua Zalo','Xác nhận trong vài phút']]
    },
    {
      key:'auto', tab:'Kỹ thuật & Gara', short:'Gara', icon:'wrench',
      accent:'accent-warm', accentPhoto:'accent-warm',
      biz:'MINH PHÁT AUTO', initials:'MP', domain:'minhphat.runlumi.app',
      navLinks:['Dịch vụ','Bảng giá','Gọi cứu hộ'],
      kicker:'Gara ô tô & Cứu hộ', live:'Cứu hộ 24/7',
      headline:'Cứu hộ 24/7, báo giá trước\u00A0khi\u00A0sửa.',
      sub:'Hotline khẩn cấp, chỉ đường tới xưởng và bảng hạng mục bảo dưỡng hiện ngay đầu trang.',
      phone:'0938 555 247',
      phoneTitle:'Gần đây. Uy tín. Gọi là có.',
      features:[['wrench','Sửa chữa & Bảo dưỡng','Đầy đủ hạng mục'],['car','Cứu hộ 24/7','Hotline luôn trực'],['receipt','Bảng giá minh bạch','Thống nhất trước khi sửa']]
    }
  ],
  en: [
    {
      key:'cafe', tab:'Café / F&B', short:'Café', icon:'cup',
      accent:'', accentPhoto:'',
      biz:'AN NHIÊN', initials:'AN', domain:'annhien.runlumi.app',
      navLinks:['Menu & Pricing','About','Contact'],
      kicker:'Local coffee shop', live:'Open now',
      headline:'A small place, presented with craft and care.',
      sub:'Menu, location, opening hours, and direct contact sit right where customers look.',
      phone:'0908 123 456',
      phoneTitle:'Good coffee. Easy to find. Easy to call.',
      features:[['cup','Roasted Coffee','Phin & Espresso'],['pastry','Fresh Pastry','Baked daily'],['chair','Quiet Workspace','Wi-Fi & work tables']]
    },
    {
      key:'spa', tab:'Spa & Beauty', short:'Spa', icon:'lotus',
      accent:'accent-fresh', accentPhoto:'accent-fresh',
      biz:'MỘC BEAUTY', initials:'MB', domain:'mocbeauty.runlumi.app',
      navLinks:['Services & Pricing','The space','Book now'],
      kicker:'Spa & skincare studio', live:'Slots today',
      headline:'Real spa calm, booked in one tap.',
      sub:'Service menu, reference pricing, and a Zalo booking button right where customers scroll.',
      phone:'0917 246 810',
      phoneTitle:'Deserved rest. Effortless booking.',
      features:[['lotus','Massage & Facials','60–90 min rituals'],['leaf','Natural skincare','Curated brands'],['calendar','Zalo booking','Confirmed in minutes']]
    },
    {
      key:'auto', tab:'Auto & Technical', short:'Auto', icon:'wrench',
      accent:'accent-warm', accentPhoto:'accent-warm',
      biz:'MINH PHÁT AUTO', initials:'MP', domain:'minhphat.runlumi.app',
      navLinks:['Services','Price list','Rescue line'],
      kicker:'Auto garage & rescue', live:'24/7 rescue',
      headline:'24/7 rescue. Quotes before repairs.',
      sub:'Emergency hotline, directions to the shop, and a clear maintenance menu right up front.',
      phone:'0938 555 247',
      phoneTitle:'Close by. Trusted. One call away.',
      features:[['wrench','Repair & Maintenance','Full service menu'],['car','24/7 roadside','Hotline always on'],['receipt','Transparent pricing','Agreed before work']]
    }
  ]
};
const inds = industries[locale];

const scenePhotos = { cafe: 'cafe', spa: 'salon', auto: 'garage' };

const industryArt = ['salon', 'garage', 'hvac'];
const otherLocale = locale === 'vi' ? 'EN' : 'VI';
const otherHref = locale === 'vi' ? '/en/' : '/';
const labels = locale === 'vi' ? { main:'Nội dung chính', nav:'Điều hướng chính', illustrative:'Giao diện mẫu', recommended:'Khuyên dùng', core:'Gói chính', switcher:'Xem trước theo ngành', receipt:'Nếu đã mua Trust Kit trong 30 ngày: được trừ 399.000đ, còn lại 1.591.000đ' } : { main:'Main content', nav:'Primary navigation', illustrative:'Illustrative concept', recommended:'Recommended', core:'Core package', switcher:'Preview by industry', receipt:'If Trust Kit was paid within 30 days: 399,000 VND credited, 1,591,000 VND remaining' };
---
<Page locale={locale} title={c.title} description={c.description}>
  <header class="site-header glass-control">
    <div class="wrap header-inner">
      <a class="brand" href={locale === 'vi' ? '/' : '/en/'} aria-label="Lumi Local">
        <img src="/brand/lumi-logo.svg" width="34" height="34" alt="" />
        <span>Lumi <strong>Local</strong></span>
      </a>
      <nav class="desktop-nav" aria-label={labels.nav}>
        {c.nav.map(([href,label]) => <a href={href}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <div class="lang-switch" role="group" aria-label={locale === 'vi' ? 'Chọn ngôn ngữ' : 'Language selector'}>
          <a class={`lang-opt ${locale === 'vi' ? 'active' : ''}`} href="/" aria-current={locale === 'vi' ? 'true' : undefined}>VI</a>
          <a class={`lang-opt ${locale === 'en' ? 'active' : ''}`} href="/en/" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <a class="button button-primary header-cta" href="#bat-dau">
          <span>{c.cta}</span>
          <ServiceIcon name="arrow" size={14} class="cta-arrow" />
        </a>
        <a class="button button-primary mobile-header-cta" href="#bat-dau">{locale === 'vi' ? 'Xem thử' : 'See a preview'}</a>
      </div>
    </div>
  </header>

  <main id="main" aria-label={labels.main}>
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">{c.hero.eyebrow}</p>
        <h1 class="local-headline">
          <span>{c.hero.title[0]}</span>
          <strong>{c.hero.title[1]}</strong>
        </h1>
        <p class="hero-description">{c.hero.text}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#bat-dau">
            <span>{c.cta}</span>
            <ServiceIcon name="arrow" size={16} class="cta-arrow" />
          </a>
          <a class="button button-secondary" href="#goi-dich-vu">
            <span>{c.hero.secondary}</span>
            <ServiceIcon name="down" size={14} />
          </a>
        </div>
        <div class="hero-price">
          <div class="price-val"><strong>{c.packages.starter.price}</strong><span>/{c.packages.starter.unit}</span></div>
          <div class="price-badge-row">
            <span class="price-pill-tag">{labels.core}</span>
            <span class="price-caption">{locale === 'vi' ? 'Dựng website + file QR + hosting & bảo trì năm đầu' : 'Website setup + QR artwork + year-one hosting & maintenance'}</span>
          </div>
        </div>
        <p class="meta">{c.hero.note}</p>
      </div>
      <div class="hero-visual">
        <div class="product-stage sheet" data-industry="cafe" aria-label={labels.illustrative}>
          <div class="stage-topline">
            <span class="stage-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="stage-domain">
              {inds.map(ind => (
                <span class="stage-domain-opt" data-domain={ind.key}>
                  <ServiceIcon name="lock" size={12} class="stage-lock-icon" />
                  <span>{ind.domain}</span>
                </span>
              ))}
            </span>
            <span class="stage-label">
              <span class="status-live-dot" aria-hidden="true"></span>
              {labels.illustrative}
            </span>
          </div>
          <div class="industry-switch" role="tablist" aria-label={labels.switcher}>
            {inds.map((ind, i) => (
              <button type="button" class={`industry-tab${i === 0 ? ' is-active' : ''}`} role="tab" id={`tab-${ind.key}`} data-industry={ind.key} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="stage-panel" tabindex={i === 0 ? 0 : -1}>
                <ServiceIcon name={ind.icon} size={16} />
                <span class="tab-label-full">{ind.tab}</span>
                <span class="tab-label-short">{ind.short}</span>
              </button>
            ))}
          </div>
          <div class="stage-canvas" id="stage-panel" role="tabpanel" aria-labelledby="tab-cafe">
            {inds.map(ind => (
              <article class="site-preview" data-variant={ind.key}>
                <div class="site-preview-nav">
                  <div class="site-preview-brand">
                    <span class={`brand-avatar ${ind.accent}`}>{ind.initials}</span>
                    <strong>{ind.biz}</strong>
                  </div>
                  <div class="site-preview-links">
                    {ind.navLinks.map(link => <span>{link}</span>)}
                  </div>
                  <div class="site-preview-cta">
                    <span><ServiceIcon name="phone" size={12} /> {ind.phone}</span>
                  </div>
                </div>
                <div class="site-preview-main">
                  <ScenePhoto name={scenePhotos[ind.key]} class="preview-scene" sizes="(max-width: 760px) 85vw, 560px" eager={ind.key === 'cafe'} />
                  <div class="mini-kicker-wrap">
                    <span class="mini-kicker">{ind.kicker}</span>
                    <span class="mini-live-tag">{ind.live}</span>
                  </div>
                  <h3>{ind.headline}</h3>
                  <p>{ind.sub}</p>
                  <div class="mini-actions">
                    <span class="action-btn-primary">
                      <ServiceIcon name="phone" size={12} />
                      {locale === 'vi' ? 'Gọi ngay' : 'Call'}
                    </span>
                    <span class="action-btn-soft">Zalo</span>
                    <span class="action-btn-soft">
                      <ServiceIcon name="pin" size={12} />
                      {locale === 'vi' ? 'Chỉ đường' : 'Directions'}
                    </span>
                  </div>
                </div>
                <div class="site-preview-bottom">
                  {ind.features.map(([icon,title,small]) => (
                    <div class="preview-feature-item">
                      <span class="feature-icon"><ServiceIcon name={icon} size={20} /></span>
                      <div><strong>{title}</strong><small>{small}</small></div>
                    </div>
                  ))}
                </div>
              </article>
            ))}
            {inds.map(ind => (
              <aside class="phone-preview" data-variant={ind.key} aria-label={locale === 'vi' ? 'Minh họa mobile' : 'Mobile illustration'}>
                <div class="phone-notch"></div>
                <div class="phone-status-bar">
                  <span>9:41</span>
                  <span class="phone-icons"><ServiceIcon name="signal" size={12} /></span>
                </div>
                <div class="phone-brand-bar">
                  <span class="phone-brand">{ind.biz}</span>
                  <span class="phone-live-dot"></span>
                </div>
                <div class="phone-photo" aria-hidden="true"><ScenePhoto name={scenePhotos[ind.key]} sizes="180px" eager={ind.key === 'cafe'} /></div>
                <strong class="phone-title">{ind.phoneTitle}</strong>
                <div class="phone-actions">
                  <span><ServiceIcon name="phone" size={12} />{locale === 'vi' ? 'Gọi' : 'Call'}</span>
                  <span>Zalo</span>
                  <span><ServiceIcon name="pin" size={12} />{locale === 'vi' ? 'Đường' : 'Map'}</span>
                </div>
              </aside>
            ))}
            {inds.map(ind => (
              <aside class="qr-stand" data-variant={ind.key} aria-label={locale === 'vi' ? 'Minh họa QR đánh giá đặt quầy' : 'Counter review QR illustration'}>
                <div class="qr-stand-header">
                  <span class="qr-brand">Lumi Local</span>
                  <span class="qr-tag">{locale === 'vi' ? 'Đặt quầy' : 'Counter'}</span>
                </div>
                <span class="qr-biz-chip">{ind.biz}</span>
                <div class="qr-google-bar" aria-hidden="true">
                  <span class="google-badge">G</span>
                  <span class="qr-honest-label">{locale === 'vi' ? 'Chia sẻ chân thật' : 'Honest feedback'}</span>
                </div>
                <strong class="qr-title">{locale === 'vi' ? 'Chia sẻ trải nghiệm' : 'Share your experience'}</strong>
                <div class="qr-pattern-box" aria-hidden="true">
                  <svg viewBox="0 0 80 80" width="70" height="70" fill="#102a43">
                    <rect x="6" y="6" width="22" height="22" rx="2" fill="none" stroke="#102a43" stroke-width="4"/>
                    <rect x="12" y="12" width="10" height="10" rx="1"/>
                    <rect x="52" y="6" width="22" height="22" rx="2" fill="none" stroke="#102a43" stroke-width="4"/>
                    <rect x="58" y="12" width="10" height="10" rx="1"/>
                    <rect x="6" y="52" width="22" height="22" rx="2" fill="none" stroke="#102a43" stroke-width="4"/>
                    <rect x="12" y="58" width="10" height="10" rx="1"/>
                    <rect x="34" y="8" width="4" height="4"/><rect x="42" y="8" width="4" height="4"/>
                    <rect x="34" y="16" width="4" height="4"/><rect x="42" y="20" width="4" height="4"/>
                    <rect x="10" y="34" width="4" height="4"/><rect x="18" y="38" width="4" height="4"/><rect x="26" y="34" width="4" height="4"/>
                    <rect x="34" y="34" width="6" height="6" fill="#006093"/>
                    <rect x="44" y="34" width="4" height="4"/><rect x="52" y="38" width="4" height="4"/><rect x="64" y="34" width="4" height="4"/>
                    <rect x="34" y="46" width="4" height="4"/><rect x="42" y="46" width="4" height="4"/><rect x="50" y="50" width="4" height="4"/>
                    <rect x="34" y="58" width="4" height="4"/><rect x="44" y="62" width="4" height="4"/><rect x="56" y="58" width="4" height="4"/><rect x="64" y="62" width="4" height="4"/>
                    <rect x="38" y="68" width="4" height="4"/><rect x="52" y="68" width="4" height="4"/><rect x="68" y="68" width="4" height="4"/>
                  </svg>
                </div>
                <small>{locale === 'vi' ? 'Quét để mở Google Review' : 'Scan to open Google Review'}</small>
                <div class="qr-stand-foot"></div>
              </aside>
            ))}
          </div>
        </div>
        <nav class="workflow-dock glass-control" aria-label={locale === 'vi' ? 'Lối tắt bảng giá' : 'Pricing shortcuts'}>
          <a href="#trust-kit" class="dock-link">
            <span class="dock-step">01</span>
            <span class="dock-title">Trust Kit</span>
            <span class="dock-price">399k</span>
          </a>
          <a href="#starter" class="dock-link dock-link-featured">
            <span class="dock-step">02</span>
            <span class="dock-title">Starter</span>
            <span class="dock-price">1.99m</span>
            <span class="dock-badge">{labels.core}</span>
          </a>
          <a href="#gia-duy-tri" class="dock-link">
            <span class="dock-step">03</span>
            <span class="dock-title">{locale === 'vi' ? 'Duy trì' : 'Renewal'}</span>
            <span class="dock-price">599k+</span>
          </a>
        </nav>
      </div>
    </section>

    <p class="wrap meta">{illustrationNote}</p>

    <section class="wrap proof-row" aria-label={locale === 'vi' ? 'Ba điều khách cần' : 'What visitors need'} data-reveal-group>
      {c.proof.map(([title,text]) => <article class="proof-card" data-reveal><span class="proof-mark"><ServiceIcon name="check" size={14} /></span><div><strong>{title}</strong><p>{text}</p></div></article>)}
    </section>

    <section class="examples wrap" aria-labelledby="examples-title">
      <div class="examples-heading" data-reveal>
        <div><p class="eyebrow">{c.examples.eyebrow}</p><h2 id="examples-title">{c.examples.title}</h2></div>
        <p class="section-intro">{c.examples.intro}<br /><small>{illustrationNote}</small></p>
      </div>
      <div class="example-rail" role="region" tabindex="0" aria-labelledby="examples-title" data-reveal-group>
        {c.examples.items.map(([type,name,meta,text],i) => <article class="example-card sheet spotlight" data-reveal>
          <div class="example-browser">
            <span class="example-dots"><i></i><i></i><i></i></span>
            <span class="example-url">
              <ServiceIcon name="lock" size={12} />
              {`demo-${i+1}.runlumi.app`}
            </span>
            <span class="example-index">0{i+1}</span>
          </div>
          <div class="example-body">
            <div class="example-art-wrap">
              <ScenePhoto name={industryArt[i]} class="industry-art" sizes="(max-width: 760px) calc(100vw - 32px), (max-width: 1440px) 32vw, 400px" />
            </div>
            <div class="example-content">
              <span class="example-type">{type}</span>
              <h3>{name}</h3>
              <p class="example-meta">{meta}</p>
              <p class="example-text">{text}</p>
              <div class="example-actions">
                <span class="example-action-btn"><ServiceIcon name="phone" size={12} />{locale === 'vi' ? 'Gọi' : 'Call'}</span>
                <span class="example-action-btn example-action-zalo">Zalo</span>
                <span class="example-action-btn"><ServiceIcon name="pin" size={12} />{locale === 'vi' ? 'Bản đồ' : 'Map'}</span>
              </div>
            </div>
          </div>
        </article>)}
      </div>
    </section>

    <section class="section wrap" id="goi-dich-vu">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">{c.packages.eyebrow}</p><h2>{c.packages.title}</h2></div>
        <p class="section-intro">{c.packages.intro}</p>
      </div>
      <div class="offer-layout" data-reveal-group>
        <article class="starter-offer sheet" id="starter" data-reveal>
          <div class="offer-header">
            <div>
              <p class="index">02</p>
              <h3>{c.packages.starter.name}</h3>
            </div>
            <span class="package-label">{labels.core}</span>
          </div>
          <div class="starter-price">
            <strong>{c.packages.starter.price}</strong>
            <span>/{c.packages.starter.unit}</span>
          </div>
          <p class="starter-summary">{c.packages.starter.text}</p>
          <div class="starter-content">
            <ul class="starter-bullets">
              {c.packages.starter.bullets.map(item => <li>
                <span class="bullet-check"><ServiceIcon name="check" size={12} /></span>
                <span>{item}</span>
              </li>)}
            </ul>
            <div class="starter-receipt" tabindex="0" role="group" aria-label={labels.receipt}>
              <div class="receipt-header">
                <span class="receipt-badge">{locale === 'vi' ? 'Chi phí năm đầu' : 'Year-one cost'}</span>
              </div>
              <div class="receipt-row">
                <span>{locale === 'vi' ? 'Năm đầu' : 'Year one'}</span>
                <strong>{c.packages.starter.price}</strong>
              </div>
              <div class="credit-bar" aria-hidden="true"><span class="credit-bar-credited"></span></div>
              <div class="credit-bar-legend" aria-hidden="true">
                <span class="legend-credited"><i></i>{locale === 'vi' ? 'Trust Kit đã trừ 399.000đ' : 'Trust Kit credit 399,000 VND'}</span>
                <span class="legend-remainder"><i></i>{locale === 'vi' ? 'Còn lại 1.591.000đ' : 'Remaining 1,591,000 VND'}</span>
              </div>
              <div class="receipt-row receipt-credit-note">
                <span>{locale === 'vi' ? 'Đã có Trust Kit (−399k)' : 'If Trust Kit already paid'}</span>
                <strong class="credit-highlight">
                  <span>{locale === 'vi' ? 'Chỉ trả +' : 'Pay only +'}</span>
                  <span class="receipt-price" data-full="1990000" data-net="1591000">{locale === 'vi' ? '1.591.000đ' : '1,591,000 VND'}</span>
                </strong>
              </div>
              <div class="receipt-footer">
                <span>{locale === 'vi' ? 'Duy trì từ năm 2: chỉ từ 599.000đ/năm' : 'Renewal from year 2: from 599k/year'}</span>
              </div>
            </div>
          </div>
          <a class="button button-primary starter-cta" href="#bat-dau">
            <span>{c.cta}</span>
            <ServiceIcon name="arrow" size={16} />
          </a>
        </article>
        <div class="offer-side" data-reveal-group>
          <article class="mini-offer sheet spotlight" id="trust-kit" data-reveal>
            <div class="mini-offer-head">
              <p class="index">01</p>
              <h3>{c.packages.trust.name}</h3>
            </div>
            <div class="price"><strong>{c.packages.trust.price}</strong><span>/{c.packages.trust.unit}</span></div>
            <p class="mini-offer-desc">{c.packages.trust.text}</p>
            <ul class="mini-bullets">
              {c.packages.trust.bullets.map(item => <li>
                <span class="bullet-check"><ServiceIcon name="check" size={12} /></span>
                <span>{item}</span>
              </li>)}
            </ul>
            <a class="text-link" href="#bat-dau"><span>{locale === 'vi' ? 'Bắt đầu nhỏ' : 'Start small'}</span><ServiceIcon name="arrow" size={16} /></a>
          </article>
          <article class="mini-offer renewal-side sheet spotlight" data-reveal>
            <div class="mini-offer-head">
              <p class="index">03</p>
              <h3>{c.packages.renewal.name}</h3>
            </div>
            <div class="price"><strong>{c.packages.renewal.price}</strong><span>/{c.packages.renewal.unit}</span></div>
            <p class="mini-offer-desc">{c.packages.renewal.text}</p>
            <a class="text-link" href="#gia-duy-tri"><span>{locale === 'vi' ? 'Chi tiết gia hạn' : 'Renewal details'}</span><ServiceIcon name="arrow" size={16} /></a>
          </article>
        </div>
      </div>
      <div class="credit-rail" data-reveal>
        <span class="credit-rail-icon"><ServiceIcon name="credit" size={24} /></span>
        <div class="credit-rail-text">
          <strong>{c.packages.credit}</strong>
        </div>
        <a class="credit-rail-action" href="#bat-dau">
          <span>{locale === 'vi' ? 'Cho Lumi xem business của tôi' : 'Show Lumi my business'}</span>
          <ServiceIcon name="arrow" size={16} />
        </a>
      </div>
    </section>

    <section class="navy-section">
      <div class="wrap">
        <div class="section-heading inverted" data-reveal>
          <div><p class="eyebrow">{c.convenience.eyebrow}</p><h2>{c.convenience.title}</h2></div>
          <p class="section-intro">{c.convenience.text}</p>
        </div>
        <div class="handoff" data-reveal-group>
          {[['you', c.convenience.you], ['lumi', c.convenience.lumi]].map(([side, part]) => (
            <article class={`handoff-card handoff-${side}`} aria-labelledby={`handoff-${side}`} data-reveal>
              <header class="handoff-head">
                <h3 class="index" id={`handoff-${side}`}>{part.label}</h3>
                <span class="handoff-count" aria-hidden="true">{part.items.length}</span>
              </header>
              {side === 'you'
                ? <ol class="handoff-list">{part.items.map((item, i) => <li><span class="handoff-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span>{item}</span></li>)}</ol>
                : <ul class="handoff-list handoff-grid">{part.items.map(item => <li><span class="handoff-check"><ServiceIcon name="check" size={14} /></span><span>{item}</span></li>)}</ul>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section wrap">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">{c.included.eyebrow}</p><h2>{c.included.title}</h2></div>
        <p class="section-intro">{c.included.intro}</p>
      </div>
      <div class="feature-grid" data-reveal-group>
        {c.included.items.map(([title,text],i) => <article class={`sheet feature-card spotlight ${i === 0 ? 'feature-primary' : ''}`} data-reveal>
          <div class="feature-card-header">
            <span class="feature-number">{String(i+1).padStart(2,'0')}</span>
            {i === 0 && <span class="feature-tag">{locale === 'vi' ? 'Nền tảng chính' : 'Core platform'}</span>}
          </div>
          <h3>{title}</h3>
          <p>{text}</p>
          <span class="deliverable-symbol" aria-hidden="true"><ServiceIcon name={['address','phone','pin','honest','hosting','check'][i]} size={32} /></span>
        </article>)}
      </div>
    </section>

    <section class="section wrap" id="cach-hoat-dong">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">{c.workflow.eyebrow}</p><h2>{c.workflow.title}</h2></div>
        <p class="section-intro">{c.workflow.intro}</p>
      </div>
      <div class="delivery-layout" data-reveal-group>
        <aside class="delivery-rail" aria-label={locale === 'vi' ? 'Bộ bàn giao trọn gói' : 'Complete handoff package'}>
          <div class="delivery-panel sheet" data-delivery-panel data-reveal>
            <div class="delivery-panel-head">
              <p class="index">{locale === 'vi' ? 'Gói bàn giao' : 'Handoff package'}</p>
              <h3>{locale === 'vi' ? 'Một gói trọn vẹn' : 'One complete package'}</h3>
              <p>{locale === 'vi' ? 'Website, nút liên hệ và QR review — hoàn chỉnh, sẵn sàng đón khách.' : 'Website, contact actions, and review QR — complete and ready for customers.'}</p>
            </div>
            <ol class="delivery-artifacts">
              <li class="delivery-artifact" data-artifact="site">
                <span class="delivery-node" aria-hidden="true"></span>
                <div class="delivery-artifact-card">
                  <div class="delivery-browser">
                    <span class="delivery-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span class="delivery-domain">
                      <ServiceIcon name="lock" size={12} />
                      annhien.runlumi.app
                    </span>
                  </div>
                  <div class="delivery-site-body">
                    <ScenePhoto name="cafe" class="delivery-scene" sizes="(max-width: 960px) 72vw, 340px" />
                    <div class="delivery-site-info">
                      <strong>{locale === 'vi' ? 'Website riêng chuẩn di động' : 'Dedicated mobile-first website'}</strong>
                      <span>Hosting · SSL · {locale === 'vi' ? 'Tên miền' : 'Domain'}</span>
                    </div>
                  </div>
                </div>
              </li>
              <li class="delivery-artifact" data-artifact="contact">
                <span class="delivery-node" aria-hidden="true"></span>
                <div class="delivery-artifact-card">
                  <strong class="delivery-artifact-title">{locale === 'vi' ? 'Khách bấm là liên hệ được' : 'One tap and customers reach you'}</strong>
                  <div class="delivery-contact-row">
                    <span class="delivery-chip delivery-chip-call">
                      <ServiceIcon name="phone" size={12} />
                      {locale === 'vi' ? 'Gọi ngay' : 'Call'}
                    </span>
                    <span class="delivery-chip delivery-chip-zalo">Zalo</span>
                    <span class="delivery-chip">
                      <ServiceIcon name="pin" size={12} />
                      {locale === 'vi' ? 'Chỉ đường' : 'Directions'}
                    </span>
                  </div>
                </div>
              </li>
              <li class="delivery-artifact" data-artifact="review">
                <span class="delivery-node" aria-hidden="true"></span>
                <div class="delivery-artifact-card">
                  <div class="delivery-qr-box" aria-hidden="true">
                    <svg viewBox="0 0 80 80" width="44" height="44" fill="#102a43">
                      <rect x="6" y="6" width="22" height="22" rx="2" fill="none" stroke="#102a43" stroke-width="5"/>
                      <rect x="12" y="12" width="10" height="10" rx="1"/>
                      <rect x="52" y="6" width="22" height="22" rx="2" fill="none" stroke="#102a43" stroke-width="5"/>
                      <rect x="58" y="12" width="10" height="10" rx="1"/>
                      <rect x="6" y="52" width="22" height="22" rx="2" fill="none" stroke="#102a43" stroke-width="5"/>
                      <rect x="12" y="58" width="10" height="10" rx="1"/>
                      <rect x="36" y="8" width="5" height="5"/><rect x="46" y="14" width="5" height="5"/>
                      <rect x="36" y="20" width="5" height="5"/><rect x="14" y="36" width="5" height="5"/>
                      <rect x="26" y="42" width="5" height="5"/><rect x="38" y="38" width="6" height="6" fill="#006093"/>
                      <rect x="50" y="34" width="5" height="5"/><rect x="62" y="40" width="5" height="5"/>
                      <rect x="36" y="50" width="5" height="5"/><rect x="48" y="56" width="5" height="5"/>
                      <rect x="60" y="62" width="5" height="5"/><rect x="38" y="66" width="5" height="5"/>
                    </svg>
                  </div>
                  <div class="delivery-site-info">
                    <strong>Google Review</strong>
                    <span>{locale === 'vi' ? 'QR đặt quầy · mời mọi khách đã ghé' : 'Counter QR · for every customer'}</span>
                  </div>
                </div>
              </li>
            </ol>
          </div>
        </aside>
        <ol class="delivery-steps">
          {c.workflow.steps.map(([i,title,text]) => <li class="delivery-step sheet" data-step={i.replace('0','')} data-reveal>
            <span class="step-index">{i}</span>
            <div class="delivery-step-body">
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </li>)}
        </ol>
      </div>
    </section>

    <section class="section wrap" id="gia-duy-tri">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">{c.renewal.eyebrow}</p><h2>{c.renewal.title}</h2></div>
        <p class="section-intro">{c.renewal.intro}</p>
      </div>
      <div class="renewal-grid" data-reveal-group>
        {c.renewal.plans.map(([name,price,text],i) => <article class={`sheet renewal-card spotlight ${i === 1 ? 'renewal-card-featured' : ''}`} data-reveal>
          <div class="renewal-card-head">
            <span class="service-emblem"><ServiceIcon name={i === 0 ? 'address' : 'domain'} /></span>
            {i === 1 && <span class="recommended">{labels.recommended}</span>}
          </div>
          <h3>{name}</h3>
          <strong class="renewal-price">{price}</strong>
          <p>{text}</p>
          <ul class="renewal-checklist">
            <li><span class="service-bullet"><ServiceIcon name="hosting" /></span><span>{locale === 'vi' ? 'Hosting + chứng chỉ SSL' : 'Hosting + SSL certificate'}</span></li>
            <li><span class="service-bullet"><ServiceIcon name="maintenance" /></span><span>{locale === 'vi' ? 'Bảo trì kỹ thuật trong phạm vi gói' : 'Technical maintenance within agreed scope'}</span></li>
            {i === 1 && <li><span class="service-bullet"><ServiceIcon name="domain" /></span><span>{locale === 'vi' ? 'Gồm 1 tên miền tiêu chuẩn đã xác nhận' : 'Includes 1 agreed standard custom domain'}</span></li>}
          </ul>
        </article>)}
      </div>
      <p class="renewal-note" data-reveal>{c.renewal.recommendation}</p>
    </section>

    <section class="section wrap trust-section">
      <div class="section-heading" data-reveal><div><p class="eyebrow">{c.trust.eyebrow}</p><h2>{c.trust.title}</h2></div></div>
      <div class="trust-grid" data-reveal-group>{c.trust.items.map(([title,text],i) => <article class="trust-card sheet" data-reveal><span class="service-emblem"><ServiceIcon name={['ownership','honest','clarity','scope'][i]} /></span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
    </section>

    <section class="section wrap faq" id="cau-hoi">
      <div class="faq-head" data-reveal>
        <p class="eyebrow">{locale === 'vi' ? 'MINH BẠCH' : 'TRANSPARENCY'}</p>
        <h2>{c.faq.title}</h2>
      </div>
      <div class="faq-list" data-reveal>{c.faq.items.map(([q,a]) => <details class="faq-item"><summary class="faq-question"><span>{q}</span><span class="faq-toggle" aria-hidden="true">+</span></summary><p class="faq-answer">{a}</p></details>)}</div>
    </section>

    <ServiceDirectory locale={locale}/>
    <section class="section wrap contact" id="bat-dau">
      <div class="contact-copy" data-reveal>
        <p class="eyebrow">{c.form.eyebrow}</p>
        <h2>{c.form.title}</h2>
        <p class="contact-intro">{c.form.text}</p>
        <div class="privacy-notice">
          <ServiceIcon name="shield" size={14} />
          <p class="meta">{c.form.privacy}</p>
        </div>
        <div class="enquiry-next">
          <p class="index">{c.form.afterTitle}</p>
          <ol>{c.form.afterSteps.map(step => <li>{step}</li>)}</ol>
        </div>
      </div>
      <EnquiryForm locale={locale}/>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a class="brand" href={locale === 'vi' ? '/' : '/en/'}>
        <img src="/brand/lumi-logo.svg" width="32" height="32" alt="" />
        <span>Lumi <strong>Local</strong></span>
      </a>
      <p>{c.footer}</p>
      <a class="back-to-top" href="#main">
        <span>{locale === 'vi' ? 'Về đầu trang' : 'Back to top'}</span>
        <ServiceIcon name="up" size={14} />
      </a>
    </div>
  </footer>

  <script is:inline type="module" src="/interactions.js"></script>
  <script is:inline type="module" src="/enquiry.js"></script>
</Page>
