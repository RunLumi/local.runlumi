  en: {
    title: 'Lumi Local | Done-for-you online presence for local businesses',
    description: 'Lumi Local handles website, review QR, Call/Zalo, hosting and technical maintenance for local businesses. Trust Kit 399k; Starter 1.99m VND in year one.',
    nav: [['#goi-dich-vu','Packages'],['#cach-hoat-dong','How it works'],['#gia-duy-tri','Renewal'],['#cau-hoi','FAQ']],
