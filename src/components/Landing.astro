const c = copy[locale];
const otherLocale = locale === 'vi' ? 'EN' : 'VI';
const otherHref = locale === 'vi' ? '/en/' : '/';
const labels = locale === 'vi' ? { main:'Nội dung chính', nav:'Điều hướng chính', illustrative:'Minh họa, không phải khách hàng thật', recommended:'Khuyên dùng', core:'Gói chính' } : { main:'Main content', nav:'Primary navigation', illustrative:'Illustrative, not a real customer', recommended:'Recommended', core:'Core package' };
---
<Page locale={locale} title={c.title} description={c.description}>
  <header class="site-header glass-control">
    <div class="wrap header-inner">
      <a class="brand" href={locale === 'vi' ? '/' : '/en/'} aria-label="Lumi Local">
        <img src="/brand/lumi-logo.svg" width="34" height="34" alt="" />
        <span>Lumi <strong>Local</strong></span>
      </a>
      <nav class="desktop-nav" aria-label={labels.nav}>
        {c.nav.map(([href,label]) => <a href={href}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="lang" href={otherHref}>{otherLocale}</a>
        <a class="button button-primary header-cta" href="#bat-dau">{c.cta}</a>
        <a class="button button-primary mobile-header-cta" href="#bat-dau">{locale === 'vi' ? 'Xem thử' : 'See demo'}</a>
      </div>
    </div>
  </header>

  <main id="main" aria-label={labels.main}>
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow">{c.hero.eyebrow}</p>
        <h1>{c.hero.title.map(line => <span>{line}</span>)}</h1>
        <p class="hero-description">{c.hero.text}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#bat-dau">{c.cta}</a>
          <a class="button button-secondary" href="#goi-dich-vu">{c.hero.secondary}</a>
        </div>
        <div class="hero-price"><strong>{c.packages.starter.price}</strong><span>{c.packages.starter.unit}</span></div>
        <p class="meta">{c.hero.note}</p>
      </div>
      <div class="hero-visual">
        <div class="product-stage sheet" aria-label={labels.illustrative}>
          <div class="stage-topline">
            <span class="stage-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="stage-domain">annhien.runlumi.app</span>
            <span class="stage-label">{labels.illustrative}</span>
          </div>
          <div class="stage-canvas">
            <article class="site-preview">
              <div class="site-preview-nav">
                <strong>AN NHIÊN</strong>
                <span>{locale === 'vi' ? 'Dịch vụ   ·   Về chúng tôi   ·   Liên hệ' : 'Services   ·   About   ·   Contact'}</span>
              </div>
              <div class="site-preview-main">
                <p class="mini-kicker">{locale === 'vi' ? 'Tiệm cà phê địa phương' : 'Local coffee shop'}</p>
                <h3>{locale === 'vi' ? 'Một nơi nhỏ, được giới thiệu thật chỉn chu.' : 'A small place, presented with care.'}</h3>
                <p>{locale === 'vi' ? 'Menu, địa chỉ, giờ mở cửa và đường liên hệ nằm ngay nơi khách cần.' : 'Menu, location, opening hours and contact paths sit where customers need them.'}</p>
                <div class="mini-actions"><span>☎ {locale === 'vi' ? 'Gọi ngay' : 'Call'}</span><span>Zalo</span><span>⌖ {locale === 'vi' ? 'Chỉ đường' : 'Directions'}</span></div>
              </div>
              <div class="site-preview-bottom"><span>{locale === 'vi' ? 'Cà phê' : 'Coffee'}</span><span>{locale === 'vi' ? 'Bánh ngọt' : 'Pastry'}</span><span>{locale === 'vi' ? 'Đặt bàn' : 'Book'}</span></div>
            </article>
            <aside class="phone-preview" aria-label={locale === 'vi' ? 'Minh họa mobile' : 'Mobile illustration'}>
              <div class="phone-notch"></div>
              <div class="phone-brand">AN NHIÊN</div>
              <div class="phone-photo" aria-hidden="true"><span></span><span></span><span></span></div>
              <strong>{locale === 'vi' ? 'Cà phê ngon. Dễ tìm. Dễ gọi.' : 'Good coffee. Easy to find. Easy to call.'}</strong>
              <div class="phone-actions"><span>☎</span><span>Zalo</span><span>⌖</span></div>
            </aside>
            <aside class="qr-stand" aria-label={locale === 'vi' ? 'Minh họa QR review' : 'Review QR illustration'}>
              <span class="qr-brand">Lumi Local</span>
              <strong>{locale === 'vi' ? 'Chia sẻ trải nghiệm' : 'Share your experience'}</strong>
              <div class="qr-pattern" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
              <small>{locale === 'vi' ? 'Quét để mở Google Review' : 'Scan to open Google Review'}</small>
            </aside>
          </div>
        </div>
        <nav class="workflow-dock glass-control" aria-label="Quick links">
          <a href="#trust-kit"><span>01</span>399k</a>
          <a href="#starter"><span>02</span>1.99m</a>
          <a href="#gia-duy-tri"><span>03</span>599k / 999k</a>
        </nav>
      </div>
    </section>

    <section class="wrap proof-row" aria-label="Reassurance">
      {c.proof.map(([title,text]) => <article><span class="proof-mark">✓</span><div><strong>{title}</strong><p>{text}</p></div></article>)}
    </section>

    <section class="examples wrap" aria-labelledby="examples-title">
      <div class="examples-heading">
        <div><p class="eyebrow">{c.examples.eyebrow}</p><h2 id="examples-title">{c.examples.title}</h2></div>
        <p>{c.examples.intro}</p>
      </div>
      <div class="example-rail">
        {c.examples.items.map(([type,name,meta,text],i) => <article class="example-card">
          <div class="example-browser">
            <span class="example-index">0{i+1}</span>
            <span class="example-url">{name.toLowerCase().replaceAll(' ','-')}.runlumi.app</span>
          </div>
          <div class="example-body">
            <p class="example-type">{type}</p>
            <h3>{name}</h3>
            <p class="example-meta">{meta}</p>
            <p>{text}</p>
            <div class="example-actions"><span>☎</span><span>Zalo</span><span>⌖</span></div>
          </div>
        </article>)}
      </div>
    </section>

    <section class="section wrap" id="goi-dich-vu">
      <div class="section-heading">
        <div><p class="eyebrow">{c.packages.eyebrow}</p><h2>{c.packages.title}</h2></div>
        <p class="section-intro">{c.packages.intro}</p>
      </div>
      <div class="offer-layout">
        <article class="starter-offer sheet" id="starter">
          <div class="offer-header"><div><p class="index">02 / {labels.core}</p><h3>{c.packages.starter.name}</h3></div><span class="package-label">{labels.core}</span></div>
          <div class="starter-price"><strong>{c.packages.starter.price}</strong><span>{c.packages.starter.unit}</span></div>
          <p class="starter-summary">{c.packages.starter.text}</p>
          <div class="starter-content">
            <ul>{c.packages.starter.bullets.map(item => <li>✓ {item}</li>)}</ul>
            <div class="starter-receipt">
              <span>{locale === 'vi' ? 'Năm đầu' : 'Year one'}</span><strong>{c.packages.starter.price}</strong>
              <span>{locale === 'vi' ? 'Nếu đã mua Trust Kit' : 'If Trust Kit is already paid'}</span><strong>+1.591.000đ</strong>
            </div>
          </div>
          <a class="button button-primary" href="#bat-dau">{c.cta}</a>
        </article>
        <div class="offer-side">
          <article class="mini-offer sheet" id="trust-kit">
            <div><p class="index">01</p><h3>{c.packages.trust.name}</h3></div>
            <div class="price"><strong>{c.packages.trust.price}</strong><span>{c.packages.trust.unit}</span></div>
            <p>{c.packages.trust.text}</p>
            <ul>{c.packages.trust.bullets.map(item => <li>✓ {item}</li>)}</ul>
            <a class="text-link" href="#bat-dau">{locale === 'vi' ? 'Bắt đầu nhỏ →' : 'Start small →'}</a>
          </article>
          <article class="mini-offer renewal-side sheet">
            <div><p class="index">03</p><h3>{c.packages.renewal.name}</h3></div>
            <div class="price"><strong>{c.packages.renewal.price}</strong><span>{c.packages.renewal.unit}</span></div>
            <p>{c.packages.renewal.text}</p>
            <a class="text-link" href="#gia-duy-tri">{locale === 'vi' ? 'Chi tiết renewal →' : 'Renewal details →'}</a>
          </article>
        </div>
      </div>
      <div class="credit-rail"><span>↗</span><strong>{c.packages.credit}</strong><a href="#bat-dau">{locale === 'vi' ? 'Cho Lumi xem business của tôi' : 'Show Lumi my business'} →</a></div>
    </section>

    <section class="navy-section">
      <div class="wrap">
        <div class="section-heading inverted">
          <div><p class="eyebrow">{c.convenience.eyebrow}</p><h2>{c.convenience.title}</h2></div>
          <p class="section-intro">{c.convenience.text}</p>
        </div>
        <div class="convenience-grid">
          {c.convenience.items.map(([i,title,text]) => <article><span class="index">{i}</span><h3>{title}</h3><p>{text}</p></article>)}
        </div>
      </div>
    </section>

    <section class="section wrap">
      <div class="section-heading">
        <div><p class="eyebrow">{c.included.eyebrow}</p><h2>{c.included.title}</h2></div>
        <p class="section-intro">{c.included.intro}</p>
      </div>
      <div class="feature-grid">
        {c.included.items.map(([title,text],i) => <article class={`sheet feature-card ${i === 0 ? 'feature-primary' : ''}`}>
          <span class="feature-number">{String(i+1).padStart(2,'0')}</span>
          <h3>{title}</h3>
          <p>{text}</p>
          {i === 0 && <div class="feature-site-proof" aria-hidden="true"><span>annhien.vn</span><strong>{locale === 'vi' ? 'Dịch vụ rõ ràng trên mobile' : 'Clear services on mobile'}</strong><div><i></i><i></i><i></i></div></div>}
        </article>)}
      </div>
    </section>

    <section class="section wrap" id="cach-hoat-dong">
      <div class="section-heading">
        <div><p class="eyebrow">{c.workflow.eyebrow}</p><h2>{c.workflow.title}</h2></div>
        <p class="section-intro">{c.workflow.intro}</p>
      </div>
      <ol class="step-grid">
        {c.workflow.steps.map(([i,title,text]) => <li><span class="step-index">{i}</span><h3>{title}</h3><p>{text}</p></li>)}
      </ol>
    </section>

    <section class="section wrap" id="gia-duy-tri">
      <div class="section-heading">
        <div><p class="eyebrow">{c.renewal.eyebrow}</p><h2>{c.renewal.title}</h2></div>
        <p class="section-intro">{c.renewal.intro}</p>
      </div>
      <div class="renewal-grid">
        {c.renewal.plans.map(([name,price,text],i) => <article class="sheet">
          <span class="index">0{i+1}</span>
          {i === 1 && <span class="recommended">{labels.recommended}</span>}
          <h3>{name}</h3><strong class="renewal-price">{price}</strong><p>{text}</p>
        </article>)}
      </div>
      <p class="renewal-note">{c.renewal.recommendation}</p>
    </section>

    <section class="section wrap">
      <div class="section-heading"><div><p class="eyebrow">{c.trust.eyebrow}</p><h2>{c.trust.title}</h2></div></div>
      <div class="trust-grid">{c.trust.items.map(([title,text]) => <article><span class="proof-mark">✓</span><h3>{title}</h3><p>{text}</p></article>)}</div>
    </section>

    <section class="section wrap faq" id="cau-hoi">
      <h2>{c.faq.title}</h2>
      <div>{c.faq.items.map(([q,a]) => <details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div>
    </section>

    <section class="section wrap contact" id="bat-dau">
      <div class="contact-copy">
        <p class="eyebrow">{c.form.eyebrow}</p>
        <h2>{c.form.title}</h2>
        <p>{c.form.text}</p>
        <p class="meta">{c.form.privacy}</p>
      </div>
      <form id="enquiry-form" class="sheet enquiry-form" method="post" action="/api/enquiries">
        <input type="hidden" name="locale" value={locale} />
        <div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
        <label class="full">{c.form.business}<input name="business" type="text" maxlength="160" autocomplete="organization" required /></label>
        <label>{c.form.name}<input name="name" type="text" maxlength="80" autocomplete="name" required /></label>
        <label>{c.form.phone}<input name="phone" type="tel" maxlength="40" autocomplete="tel" inputmode="tel" required /></label>
        <details class="optional-fields full">
          <summary>{locale === 'vi' ? 'Thêm email hoặc ghi chú (không bắt buộc)' : 'Add email or a note (optional)'}</summary>
          <div class="optional-grid">
            <label>{c.form.email}<input name="email" type="email" maxlength="254" autocomplete="email" /></label>
            <label>{c.form.note}<textarea name="note" rows="3" maxlength="1000"></textarea></label>
          </div>
        </details>
        <label class="consent full"><input name="consent" type="checkbox" value="yes" required /><span>{c.form.consent}</span></label>
        <p class="form-status full" id="form-status" role="status" aria-live="polite" data-success={c.form.success} data-error={c.form.error}></p>
        <button class="button button-primary full" type="submit">{c.form.submit}</button>
      </form>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a class="brand" href={locale === 'vi' ? '/' : '/en/'}><img src="/brand/lumi-logo.svg" width="32" height="32" alt="" /><span>Lumi <strong>Local</strong></span></a>
      <p>{c.footer}</p>
      <a href="#main">{locale === 'vi' ? 'Về đầu trang ↑' : 'Back to top ↑'}</a>
    </div>
  </footer>

  <script is:inline type="module" src="/enquiry.js"></script>
</Page>
