---
import ServicePage from '../../../components/services/ServicePage.astro';
import {pages} from '../../../services/content';
import {serviceRoutes} from '../../../services/routes.js';
export function getStaticPaths(){return pages.filter(p=>serviceRoutes[p.key].type==='service').map(page=>({params:{slug:serviceRoutes[page.key].en.split('/')[3]},props:{page}}));}
const {page}=Astro.props;
---
<ServicePage page={page} locale="en"/>
