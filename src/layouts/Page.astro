---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import '../styles/local.css';

interface Props {
  locale: 'vi' | 'en';
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const origin = 'https://local.runlumi.app';
const canonical = new URL(Astro.url.pathname, origin).href;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F4F0E8" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <script is:inline src="/boot.js"></script>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="vi" href={origin + '/'} />
    <link rel="alternate" hreflang="en" href={origin + '/en/'} />
    <link rel="alternate" hreflang="x-default" href={origin + '/'} />
    <link rel="icon" href="/brand/lumi-logo.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumi Local" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={origin + '/social-card.svg'} />
    <meta property="og:image:alt" content="Lumi Local — done-for-you online presence for local businesses" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={origin + '/social-card.svg'} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'vi' ? 'Bỏ qua đến nội dung' : 'Skip to content'}</a>
    <slot />
  </body>
</html>
