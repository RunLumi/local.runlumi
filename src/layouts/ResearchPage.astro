---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import '../styles/data.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e8" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content="Explore Lumi Local keyword research: source data, monthly trends, offer fit, content hypotheses and evidence limits." />
    <link rel="canonical" href="https://local.runlumi.app/data/" />
    <link rel="icon" href="/brand/lumi-logo.svg" type="image/svg+xml" />
    <title>Keyword intelligence · Lumi Local</title>
  </head>
  <body class="data-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
