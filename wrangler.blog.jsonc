{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumi-local-blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist-blog/client" },
  "d1_databases": [{ "binding": "BLOG_DB", "database_name": "lumi-local-blog" }],
  "r2_buckets": [{ "binding": "BLOG_MEDIA", "bucket_name": "lumi-local-blog-media" }],
  "observability": { "enabled": false },
  "workers_dev": false
}
