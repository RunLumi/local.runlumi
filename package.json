{
  "name": "@runlumi/local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.js",
    "dev:blog": "LUMI_BLOG_CMS=1 astro dev --host 127.0.0.1 --port 4324",
    "build:blog": "LUMI_BLOG_CMS=1 astro build && node scripts/protect-blog-build.mjs",
    "blog:seed": "node scripts/blog-seed.mjs",
    "blog:import": "node scripts/blog-import.mjs",
    "test:blog:cms": "node scripts/verify-blog-cms.mjs",
    "test:blog:proxy": "node scripts/verify-blog-proxy.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@astrojs/react": "6.0.6",
    "@emdash-cms/cloudflare": "0.38.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.3.2",
    "astro-portabletext": "0.11.4",
    "emdash": "0.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "wrangler": "4.140.0"
  },
  "emdash": {
    "seed": "seed/blog.json"
  },
  "overrides": {
    "undici@^7": "7.29.1"
  }
}
